{
  "name": "agent-shim",
  "version": "0.1.0",
  "description": "Node --require preload that makes any Node-based AI agent CLI operate a remote Linux machine from Windows via SSH (SFTP + exec).",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node test/integration/remote-verify.js"
  },
  "keywords": [
    "ssh",
    "sftp",
    "remote",
    "bridge",
    "shim",
    "preload",
    "agent",
    "qoder"
  ],
  "license": "MIT",
  "files": [
    "lib/",
    "remote-default.json",
    ".agent-shim.example.json",
    "README.md"
  ],
  "dependencies": {
    "remote-cp-node": "^1.0.1",
    "remote-fs-node": "^1.0.3",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0"
  }
}
